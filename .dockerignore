# Dependensi dan hasil build: dipasang/dibangun ulang di dalam image.
node_modules
.next
*.tsbuildinfo

# Rahasia dan riwayat: tidak boleh ikut ke dalam image.
.env
.env.*
!.env.example
.git

# Berkas kerja lokal.
tmp
coverage
*.log

# Data unggahan pengguna dan basis data lokal: milik volume, bukan image.
public/uploads
prisma/dev.db

# Dokumentasi dan skrip pengembangan: tidak dipakai saat runtime.
docs
.agents
push.sh
mock-vouchers.csv
